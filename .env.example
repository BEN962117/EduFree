# Required: exact GitHub Pages origin, no trailing slash
ALLOWED_ORIGIN=https://ben962117.github.io
PORT=3000

# Supabase: use the Project URL and a SECRET key on the server only.
# Never put SUPABASE_SECRET_KEY in index.html or expose it to students.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Private admin dashboard credentials
FEEDBACK_ADMIN_USER=choose_a_private_admin_username
FEEDBACK_ADMIN_PASSWORD=use_a_long_unique_password

# Email notifications through Resend (optional)
RESEND_API_KEY=re_secret_replace_me
FEEDBACK_TO_EMAIL=your_private_admin_email@example.com
FEEDBACK_FROM_EMAIL=EduFree Feedback <feedback@your-verified-domain.example>

# Optional: leave unset if you are not enabling the AI tutor yet
# OPENAI_API_KEY=secret_key_here
# OPENAI_MODEL=gpt-5.5
